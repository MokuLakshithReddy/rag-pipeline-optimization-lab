# Application Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501

# Storage Paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
INDEX_DIR=data/indices
BENCHMARK_DIR=data/benchmarks
REPORTS_DIR=reports

# Retrieval & Pipeline Defaults
DEFAULT_EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEFAULT_CHUNKER=recursive
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64
DEFAULT_TOP_K=5
DEFAULT_RRF_K=60

# Generation / LLM Settings
# If LLM_PROVIDER is mock, deterministic grounded extractive responses are returned.
# Set LLM_PROVIDER=gemini or huggingface for external / local generation
LLM_PROVIDER=mock
GEMINI_API_KEY=
HF_TOKEN=

# Security & Limits
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENTS=100
ALLOWED_EXTENSIONS=.pdf,.txt,.md,.json,.csv
RATE_LIMIT_PER_MINUTE=60
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

